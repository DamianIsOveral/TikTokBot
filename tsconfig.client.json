{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist/browser",
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src/client/**/*.ts", "src/shared/**/*.ts"]
}
