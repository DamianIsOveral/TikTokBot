HOST=127.0.0.1
PORT=3000
# Publieke HTTPS-proxy: stel ook HOST=0.0.0.0 in en registreer de Discord-callback.
PUBLIC_ORIGIN=
TIKTOK_USERNAME=faynominaal
BOT_USERNAME=faynominaalbot
BOT_ENABLED=false
TIKTOK_CHAT_TRANSPORT=euler
LIVE_AUTO_RECONNECT=true
LIVE_AUTO_CONNECT=false
TIKTOK_MODERATION_ENABLED=false
EULER_API_KEY=
TIKTOK_SESSION_ID=
TIKTOK_MS_TOKEN=
TIKTOK_VERIFY_FP=
TIKTOK_TARGET_IDC=
# Alleen instellen na toestemming om botcookies naar deze Euler-host te sturen.
WHITELIST_AUTHENTICATED_SESSION_ID_HOST=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback
DISCORD_ADMIN_IDS=
