{
  "name": "faynominaal-live",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit",
    "start": "npm run build && node --env-file-if-exists=.env src/server/main.ts",
    "start:server": "node --env-file-if-exists=.env src/server/main.ts",
    "dev": "npm run build && node --watch --env-file-if-exists=.env src/server/main.ts",
    "test": "npm run build && node --test test/*.test.ts",
    "probe:tiktok": "node --env-file-if-exists=.env scripts/probe-tiktok.ts",
    "check": "npm run typecheck && node scripts/check.ts"
  },
  "dependencies": {
    "tiktok-live-connector": "2.5.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
