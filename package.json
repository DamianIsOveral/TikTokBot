{
  "name": "faynominaal-live",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit",
    "start": "npm run build && node --env-file-if-exists=.env src/server/main.ts",
    "start:server": "node --env-file-if-exists=.env src/server/main.ts",
    "dev": "npm run build && node --watch --env-file-if-exists=.env src/server/main.ts",
    "test": "npm run build && node --test test/*.test.ts",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=\"src/server/**/*.ts\" --test-coverage-include=\"src/shared/**/*.ts\" --test-coverage-lines=94 --test-coverage-branches=90 --test-coverage-functions=93 test/*.test.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "probe:tiktok": "node --env-file-if-exists=.env scripts/probe-tiktok.ts",
    "probe:tiktok-signing": "node scripts/probe-tiktok-signing.ts",
    "inspect:tiktok-har": "node scripts/inspect-tiktok-har.ts",
    "config:check": "node --env-file-if-exists=.env scripts/config-check.ts",
    "probe:tiktok-moderation": "node --env-file-if-exists=.env scripts/probe-tiktok-moderation.ts",
    "check": "npm run typecheck && node scripts/check.ts && node scripts/check-tracked.ts"
  },
  "dependencies": {
    "tiktok-live-connector": "2.5.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
